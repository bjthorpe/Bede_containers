Bootstrap: docker
From: python:3.11
%files
    {{ toolkit_home }}/Scripts/HAProxy.cfg cfg/
    {{ toolkit_home }}/Scripts/ML_server.py prediction/
    {{ toolkit_home }}/Scripts/Matbench_Models.py prediction/
    {{ toolkit_home }}/Scripts/utility prediction/utility
    {{ toolkit_home }}/Scripts/server prediction/server
    {{ toolkit_home }}/Scripts/Nequip_compile.sh /Models/compile/
    {{ toolkit_home }}/Models/NequIP  /Models/Nequip
    
%post -c /bin/bash
    export NEQUIP_CACHE_DIR=/Models/Nequip
    export CUDA_HOME=/usr/local/cuda
    apt update
    apt install -y build-essential curl
    python3 -m venv /envs/ML_env
    source /envs/ML_env/bin/activate
    pip install --upgrade pip
    pip install nequip
    mkdir -p /Models/Nequip
    # download the pre-trained model
    curl {{ url }} -o /Models/Nequip/{{ model_name }}-0.1.nequip.zip
    #compile the downloaded model
    /Models/compile/Nequip_compile.sh \
    /Models/Nequip/{{ model_name }}-0.1.nequip.zip \
    mir-group__{{ model_name }}__0.1.nequip.pt2 cuda

%startscript
    python3 --version


%environment
    #export CUDA_HOME=/usr/local/cuda
    export NEQUIP_CACHE_DIR=/Models/Nequip