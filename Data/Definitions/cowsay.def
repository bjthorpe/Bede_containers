Bootstrap: docker
From: ubuntu:24.04

%post -c /bin/bash
    apt-get update && \
    apt-get install -y locales && \
    locale-gen en_US.UTF-8 && \
    apt -y install cowsay fortune-mod

    # we don't really need anything from the host system 
    # so this is just a bodge to get rid of the error about 
    # not using the toolkit_home build option  
    echo "Nothing to copy from {{ toolkit_home }}"

%startscript
    # Run cowsay with a default message
    /usr/games/fortune | /usr/games/cowsay 

%runscript
    # Run cowsay with a given message
    /usr/games/fortune | /usr/games/cowsay

%environment
    PATH=/usr/games/