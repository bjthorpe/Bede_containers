Bootstrap: docker
From: pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
#%files
#   scripts/huggingface.exp /scripts/huggingface.exp

%post -c /bin/bash
    apt update
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt install -y curl git g++
    pip3 install fairchem-core==1.10.0 torch_scatter torch_sparse

# download the pre-trained model from hugging face with the provided API key.
    echo "downloading pre-trained model {{ checkpoint_file }} from hugging face."
    bash <(curl -sSL https://g.bodaay.io/hfd) download facebook/OMAT24 -t {{ HF_AUTH }}

%startscript
    python3 --version

%runscript
    python3 --version
