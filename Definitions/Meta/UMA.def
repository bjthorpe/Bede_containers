Bootstrap: docker
From: python:3.11

%post -c /bin/bash
    apt update
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC \ 
    apt install -y curl git g++
# directory to store HFmodels
    mkdir /Models
    export HF_HOME=/Models
    export HF_HUB_CACHE=/Models/hub

# Install final dependencies
    python3 -m venv /envs/UMA && \
    source /envs/UMA/bin/activate && \
    pip install fairchem-core==2.13.0
# login to huggingface to shut it up
    hf auth login --token {{ HF_AUTH }}
#  download models with the provided API key.
    echo "Downloading model file {{ checkpoint_file }}"    
    hf download --token {{ HF_AUTH }} facebook/UMA {{ checkpoint_file }} && \
    hf download --token {{ HF_AUTH }} facebook/UMA references/form_elem_refs.yaml && \
    hf download --token {{ HF_AUTH }} facebook/UMA references/iso_atom_elem_refs.yaml
%startscript 
    python3 --version

%environment
    export HF_HOME=/Models
    export HF_HUB_CACHE=/Models/hub
    export PATH="/envs/UMA/bin:$PATH"
    export FAIRCHEM_CACHE_DIR=/Models/hub