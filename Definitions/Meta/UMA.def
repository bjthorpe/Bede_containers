Bootstrap: docker
#From: python:3.12
From: pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
#%files
#   scripts/huggingface.exp /scripts/huggingface.exp

%post -c /bin/bash
    apt update
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt install -y curl git g++
    pip3 install fairchem-core==2.13 torch_scatter torch_sparse

# check to see if we have the model if not download 
# it with the provided API key.
    bash <(curl -sSL https://g.bodaay.io/hfd) download facebook/UMA -t {{ HF_AUTH }}

%startscript
    python3 --version

%runscript
    python3 --version
