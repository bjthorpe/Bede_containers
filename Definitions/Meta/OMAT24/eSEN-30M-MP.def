Bootstrap: docker
#From: python:3.12
From: pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
%files
    scripts/huggingface.exp /scripts/huggingface.exp
    Models/FairChem /models/FairChem

%post
    apt update
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt install -y wget expect git g++
    pip3 install fairchem-core==1.10.0 torch_scatter torch_sparse

# check to see if we have the model if not download 
# it with the provided API key.
    if [ ! -f /models/FairChem/esen_30m_mptrj.pt ]; then
        echo "Model not found locally so downloading."
        /scripts/huggingface.exp {{ HF_AUTH }} && \
        hf download facebook/OMAT24 esen_30m_mptrj.pt && \
        mv /root/.cache/huggingface/hub/models--facebook--OMAT24/snapshots/*/esen_30m_mptrj.pt /models/FairChem
        hf auth logout
    else
        echo "Model found locally so not downloading."
    fi

%startscript
    python3 --version

%runscript
    python3 --version