Bootstrap: docker
From: pytorch/pytorch:2.9.0-cuda13.0-cudnn9-devel
%post -c /bin/bash

    apt update
    apt install -y build-essential
    python3 -m venv /envs/ML_env
    source /envs/ML_env/bin/activate
    pip install --upgrade pip
    pip install nequip

%startscript
    python3 --version

%runscript
    python3 --version

%environment
    CUDA_HOME=/usr/local/cuda
