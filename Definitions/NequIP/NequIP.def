Bootstrap: docker
From: python:3.11
%files
    scripts/HAProxy.cfg cfg/
    scripts/ML_server.py prediction/
    scripts/Matbench_Models.py prediction/
    scripts/utility prediction/utility
    scripts/server prediction/server
    scripts/Nequip_compile.sh /Models/compile
    Models/Nequip  /Models/Nequip
    
%post -c /bin/bash
    export NEQUIP_CACHE_DIR=/Models/Nequip
    export CUDA_HOME=/usr/local/cuda
    apt update
    apt install -y build-essential
    python3 -m venv /envs/ML_env
    source /envs/ML_env/bin/activate
    pip install --upgrade pip
    pip install nequip
    mkdir -p /Models/Nequip
    /Models/compile/Nequip_compile.sh 

%startscript
    python3 --version


%environment
    export CUDA_HOME=/usr/local/cuda
    export NEQUIP_CACHE_DIR=/Models/Nequip